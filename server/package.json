{
  "name": "clipvault",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "db:seed": "tsx src/seed.ts",
    "db:reset": "rm -f data/clipvault.db && npm run db:seed",
    "media": "tsx src/seed-media.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.10",
    "@fastify/view": "^11.1.1",
    "better-sqlite3": "^12.4.1",
    "ejs": "^3.1.10",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
