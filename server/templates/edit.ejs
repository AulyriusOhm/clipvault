<%- include('partials/shell-start', { title: title, active: 'library' }) %>

    <header class="topbar">
      <div>
        <p class="micro"><a href="/library">Library</a> · <a href="/watch/<%= clip.slug %>">clip</a> · edit</p>
        <h1 class="page-title mt2">Edit clip</h1>
        <p class="page-sub">#<%= String(clip.code).padStart(4, '0') %> — <%= clip.slug %> · <%= fmt.duration(clip.duration_s) %> · <%= fmt.bytes(clip.size_bytes) %></p>
      </div>
      <div class="topbar__actions">
        <a class="btn" href="/watch/<%= clip.slug %>"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-left"></use></svg>Back to clip</a>
      </div>
    </header>

    <div class="content">

      <% if (flash) { %>
      <div class="alert alert--ok mb4" role="status">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-check"></use></svg>
        <div><p><%= flash %></p></div>
      </div>
      <% } %>

      <form method="post" action="/clips/<%= clip.slug %>">
      <div class="upload-cols">

        <div class="stack">
          <section>
            <div class="rule-label"><span>Metadata</span></div>
            <div class="panel">
              <div class="field">
                <label for="title">Title</label>
                <input class="input" id="title" name="title" type="text" maxlength="90" value="<%= clip.title %>" required>
                <span class="field__hint">90 characters maximum</span>
              </div>

              <div class="form-grid mt4">
                <div class="field">
                  <label for="game">Game</label>
                  <input class="input" id="game" name="game" type="text" value="<%= clip.game_name || '' %>" list="jeux">
                  <datalist id="jeux">
                    <% games.forEach(function (game) { %><option value="<%= game.name %>"><% }); %>
                  </datalist>
                </div>
                <div class="field">
                  <label for="tags">Tags</label>
                  <input class="input" id="tags" name="tags" type="text" value="<%= tagsValue %>" placeholder="clutch, ace, ranked">
                  <span class="field__hint">comma-separated<% if (settings.default_tags) { %> — instance default: <%= settings.default_tags %><% } %></span>
                  <div class="tag-palette" data-tag-palette="tags">
                    <% tagPalette.forEach(function (tag) { %>
                    <button class="tag tag--chip" type="button" data-tag="<%= tag %>" aria-pressed="false"><%= tag %></button>
                    <% }); %>
                    <button class="tag tag--chip tag--clear" type="button" data-clear="tags">Clear</button>
                  </div>

                </div>
              </div>

              <div class="field mt4">
                <label for="description">Description</label>
                <textarea class="textarea" id="description" name="description" rows="4"><%= clip.description %></textarea>
              </div>

              <div class="row-actions mt5">
                <button class="btn btn--primary" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-check"></use></svg>Save</button>
                <a class="btn btn--ghost" href="/watch/<%= clip.slug %>">Cancel</a>
              </div>
            </div>
          </section>

          <section>
            <div class="rule-label"><span>File</span></div>
            <div class="panel">
              <div class="dl">
                <div><span class="dl__k">Resolution</span><span class="dl__v"><%= fmt.resolution(clip.width, clip.height) %></span></div>
                <div><span class="dl__k">Frame rate</span><span class="dl__v"><%= Math.round(clip.fps) %> fps</span></div>
                <div><span class="dl__k">Codec</span><span class="dl__v"><%= clip.codec || '—' %></span></div>
                <div><span class="dl__k">Duration</span><span class="dl__v"><%= fmt.duration(clip.duration_s) %></span></div>
                <div><span class="dl__k">Size</span><span class="dl__v"><%= fmt.bytes(clip.size_bytes) %></span></div>
                <div><span class="dl__k">Uploaded by</span><span class="dl__v"><%= clip.uploader || '—' %></span></div>
                <div><span class="dl__k">On</span><span class="dl__v"><%= fmt.dateLong(clip.created_at) %></span></div>
                <% if (clip.source_path) { %>
                <div><span class="dl__k">Source</span><span class="dl__v mono"><%= clip.source_path %></span></div>
                <% } %>
              </div>
              <p class="mono mt3">The video file itself cannot be replaced: delete the clip and upload a corrected version.</p>
              <form method="post" action="/clips/<%= clip.slug %>/delete" onsubmit="return confirm('Permanently delete this clip and its derivatives?')">
                <button class="btn btn--danger btn--sm" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-trash"></use></svg>Delete clip</button>
              </form>
            </div>
          </section>
        </div>

        <div class="stack">
          <section>
            <div class="rule-label"><span>Visibility</span></div>
            <div class="panel">
              <div class="radio-list">
                <label class="radio<%= clip.visibility === 'link' ? ' is-checked' : '' %>">
                  <input type="radio" name="visibility" value="link"<%= clip.visibility === 'link' ? ' checked' : '' %>>
                  <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-lock"></use></svg>
                  <span>Link access</span>
                  <span class="num">unlisted</span>
                </label>
                <label class="radio<%= clip.visibility === 'members' ? ' is-checked' : '' %>">
                  <input type="radio" name="visibility" value="members"<%= clip.visibility === 'members' ? ' checked' : '' %>>
                  <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-user"></use></svg>
                  <span>Instance members</span>
                  <span class="num"><%= counting.members %></span>
                </label>
                <label class="radio<%= clip.visibility === 'public' ? ' is-checked' : '' %>">
                  <input type="radio" name="visibility" value="public"<%= clip.visibility === 'public' ? ' checked' : '' %>>
                  <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-globe"></use></svg>
                  <span>Public</span>
                  <span class="num">no account</span>
                </label>
              </div>
              <div class="field mt4">
                <label for="expiry_days">Link expiry</label>
                <input class="input" id="expiry_days" name="expiry_days" type="number" min="0" max="365"
                       value="<%= clip.share_expires ? Math.max(0, Math.ceil((new Date(clip.share_expires.replace(' ', 'T') + 'Z').getTime() - Date.now()) / 86400000)) : 0 %>">
                <span class="field__hint">in days — 0 = no expiry</span>
              </div>
              <p class="mono mt4 faint">The “Save” button in the left column also applies the visibility.</p>
            </div>
          </section>
        </div>

      </div>
      </form>
    </div>

<script src="/assets/tags.js" defer></script>

<%- include('partials/shell-end') %>
