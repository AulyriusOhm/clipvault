<!DOCTYPE html>
<html lang="en" data-theme="<%= theme.key %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %></title>
<meta name="theme-color" content="<%= theme.background %>">
<link rel="stylesheet" href="/assets/styles.css">
</head>
<body>

<a class="skip" href="#contenu">Skip to content</a>

<%- include('partials/sprite') %>

<div class="auth">

  <aside class="auth__aside">
    <a class="auth__head" href="/" aria-label="Back to home">
      <svg aria-hidden="true" focusable="false" class="brand__mark"><use href="#i-logo"></use></svg>
      <div>
        <div class="brand__name">CLIP<span>VAULT</span></div>
        <div class="brand__sub"><%= instance %> instance · v0.1</div>
      </div>
    </a>

    <div class="auth__figure">
      <h2 class="page-title">Your group's clips,<br>kept at home.</h2>
      <p class="dim mt3">A simple uploader for game captures: drop a file, share a link,
        that's it.</p>

      <% if (showcase.length) { %>
      <div class="flex mt4">
        <% showcase.forEach(function (clip) { %>
        <a class="thumb thumb--hoverable" href="/c/<%= clip.slug %>" style="width:150px;border:1px solid var(--border);border-radius:2px" title="<%= clip.title %>">
          <% if (clip.thumb_path) { %>
          <img class="thumb__img" src="/media/<%= clip.slug %>/thumb" alt="<%= clip.title %>" loading="lazy">
          <% } %>
          <span class="thumb__code">#<%= String(clip.code).padStart(4, '0') %></span>
          <span class="thumb__dur"><%= fmt.duration(clip.duration_s) %></span>
        </a>
        <% }); %>
      </div>
      <p class="mono mt3 faint"><%= showcase.length %> clip<%= showcase.length > 1 ? 's' : '' %> open to anyone on this instance</p>
      <% } %>
    </div>

    <div>
      <div class="auth__statline">
        <div class="auth__stat"><div class="v"><%= counting.clips %></div><div class="k micro">Clips</div></div>
        <div class="auth__stat"><div class="v"><%= fmt.bytes(counting.bytes) %></div><div class="k micro">Stored</div></div>
        <div class="auth__stat"><div class="v"><%= counting.members %></div><div class="k micro">Members</div></div>
        <div class="auth__stat"><div class="v"><%= counting.games %></div><div class="k micro">Games</div></div>
      </div>
    </div>
  </aside>

  <main class="auth__main" id="contenu">

    <div class="auth__card">
      <div class="rule-label"><span>Sign in</span></div>
      <h1 class="section-title">Sign in to <%= instance %></h1>
      <p class="dim">Authentication goes through Authentik (OpenID Connect).
        ClipVault never stores a password.</p>

      <% if (error) { %>
      <div class="alert" role="alert">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-alert"></use></svg>
        <div>
          <p><strong>Sign-in denied</strong> — <%= error %></p>
          <p class="mono mt2">ask an administrator for an invitation</p>
        </div>
      </div>
      <% } %>

      <% if (authMode === 'dev') { %>
      <form method="post" action="/auth/dev-login">
        <input type="hidden" name="next" value="<%= next %>">
        <button class="btn btn--primary btn--block" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-shield"></use></svg>Sign in (dev mode)</button>
      </form>
      <p class="mono mt3">AUTH_MODE=dev — Authentik is not configured on this instance.
        Set OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and OIDC_REDIRECT_URI to switch to real SSO.</p>
      <% } else { %>
      <a class="btn btn--primary btn--block" href="/auth/start?next=<%= encodeURIComponent(next) %>"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-shield"></use></svg>Sign in with Authentik</a>
      <% } %>

      <div class="divider"><span>or</span></div>

      <a class="btn btn--ghost btn--block" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-eye"></use></svg>Continue in read-only mode</a>

    </div>
  </main>

</div>

</body>
</html>
