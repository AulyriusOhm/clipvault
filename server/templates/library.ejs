<%- include('partials/shell-start', { title: title, active: 'library' }) %>

    <form method="get" action="/library">
    <header class="topbar">
      <div>
        <h1 class="page-title">Bibliothèque</h1>
        <p class="page-sub"><%= instance %> — <%= counting.clips %> clips · <%= fmt.bytes(counting.bytes) %> · <%= counting.games %> jeux</p>
      </div>
      <div class="topbar__actions">
        <label class="search">
          <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-search"></use></svg>
          <input class="input" type="search" name="q" value="<%= query.search %>" placeholder="Rechercher un clip, un jeu, un joueur…" aria-label="Rechercher">
        </label>
        <div class="select-wrap">
          <select class="select" name="sort" aria-label="Tri">
            <option value="recent"<%= query.sort === 'recent' ? ' selected' : '' %>>Tri : plus récents</option>
            <option value="old"<%= query.sort === 'old' ? ' selected' : '' %>>Tri : plus anciens</option>
            <option value="duration"<%= query.sort === 'duration' ? ' selected' : '' %>>Tri : durée</option>
            <option value="size"<%= query.sort === 'size' ? ' selected' : '' %>>Tri : taille de fichier</option>
            <option value="alpha"<%= query.sort === 'alpha' ? ' selected' : '' %>>Tri : alphabétique</option>
          </select>
          <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
        </div>
        <button class="btn btn--primary" type="submit">Filtrer</button>
      </div>
    </header>

    <div class="content">

      <div class="filters">
        <div class="filter">
          <span class="micro">Jeu</span>
          <div class="select-wrap">
            <select class="select" name="game" aria-label="Filtre jeu">
              <option value="">Tous les jeux</option>
              <% games.forEach(function (game) { %>
              <option value="<%= game.slug %>"<%= query.game === game.slug ? ' selected' : '' %>><%= game.name %> (<%= game.count %>)</option>
              <% }); %>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Tag</span>
          <div class="select-wrap">
            <select class="select" name="tag" aria-label="Filtre tag">
              <option value="">Tous les tags</option>
              <% tags.forEach(function (tag) { %>
              <option value="<%= tag %>"<%= query.tag === tag ? ' selected' : '' %>><%= tag %></option>
              <% }); %>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Date</span>
          <div class="select-wrap">
            <select class="select" name="date" aria-label="Filtre date">
              <option value=""<%= !query.date ? ' selected' : '' %>>Tout</option>
              <option value="7"<%= query.date === '7' ? ' selected' : '' %>>7 derniers jours</option>
              <option value="30"<%= query.date === '30' ? ' selected' : '' %>>30 derniers jours</option>
              <option value="365"<%= query.date === '365' ? ' selected' : '' %>>Cette année</option>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Durée</span>
          <div class="select-wrap">
            <select class="select" name="duration" aria-label="Filtre durée">
              <option value=""<%= !query.duration ? ' selected' : '' %>>Toutes durées</option>
              <option value="short"<%= query.duration === 'short' ? ' selected' : '' %>>&lt; 1 min</option>
              <option value="mid"<%= query.duration === 'mid' ? ' selected' : '' %>>1 – 3 min</option>
              <option value="long"<%= query.duration === 'long' ? ' selected' : '' %>>&gt; 3 min</option>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filters__right">
          <span class="mono"><%= total %> résultat<%= total > 1 ? 's' : '' %> · <%= perPage %> par page</span>
          <a class="btn btn--ghost btn--sm" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-refresh"></use></svg>Réinitialiser</a>
        </div>
      </div>
    </form>

      <% if (!user) { %>
      <div class="session-note mb4">
        <svg aria-hidden="true" focusable="false" class="ic ic--sm faint"><use href="#i-lock"></use></svg>
        <span class="grow">Vue publique — <%= total %> clip<%= total > 1 ? 's' : '' %> accessible<%= total > 1 ? 's' : '' %> sans compte.
          <% if (counting.clips > total) { %><%= counting.clips - total %> autres sont réservés aux membres.<% } %></span>
        <a class="btn btn--sm" href="/login">Se connecter</a>
      </div>
      <% } %>

      <% if (clips.length) { %>
      <div class="grid-clips">
        <% clips.forEach(function (clip) { %>
        <%- include('partials/clip-card', { clip: clip }) %>
        <% }); %>
      </div>

      <% if (pages > 1) { %>
      <% function pageUrl(target) {
           const params = new URLSearchParams();
           if (query.search) params.set('q', query.search);
           if (query.game) params.set('game', query.game);
           if (query.tag) params.set('tag', query.tag);
           if (query.date) params.set('date', query.date);
           if (query.duration) params.set('duration', query.duration);
           if (query.sort !== 'recent') params.set('sort', query.sort);
           params.set('page', String(target));
           return '/library?' + params.toString();
         } %>
      <div class="pager">
        <span class="mono"><%= (page - 1) * perPage + 1 %>–<%= Math.min(page * perPage, total) %> sur <%= total %></span>
        <div class="pager__pages">
          <% if (page > 1) { %>
          <a href="<%= pageUrl(page - 1) %>" aria-label="Page précédente"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-left"></use></svg></a>
          <% } %>
          <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p += 1) { %>
            <% if (p === page) { %>
            <span class="is-current" aria-current="page"><%= p %></span>
            <% } else { %>
            <a href="<%= pageUrl(p) %>"><%= p %></a>
            <% } %>
          <% } %>
          <% if (page < pages) { %>
          <a href="<%= pageUrl(page + 1) %>" aria-label="Page suivante"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-right"></use></svg></a>
          <% } %>
        </div>
        <span class="mono faint"><%= pages %> pages</span>
      </div>
      <% } %>

      <% } else { %>
      <div class="empty">
        <svg aria-hidden="true" focusable="false" class="ic ic--lg"><use href="#i-search"></use></svg>
        <p class="section-title">Aucun clip ne correspond à ces filtres</p>
        <p class="dim">La recherche porte sur les titres, les jeux, les descriptions et les tags.</p>
        <div class="flex">
          <a class="btn btn--primary" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-refresh"></use></svg>Tout réinitialiser</a>
          <a class="btn btn--ghost" href="/upload"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-upload"></use></svg>Déposer un clip</a>
        </div>
      </div>
      <% } %>

    </div>

<%- include('partials/shell-end') %>
