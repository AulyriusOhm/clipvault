<%- include('partials/shell-start', { title: title, active: 'library' }) %>

    <form method="get" action="/library">
    <header class="topbar">
      <div>
        <h1 class="page-title">Library</h1>
        <p class="page-sub"><%= instance %> — <%= counting.clips %> clips · <%= fmt.bytes(counting.bytes) %> · <%= counting.games %> games</p>
      </div>
      <div class="topbar__actions">
        <label class="search">
          <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-search"></use></svg>
          <input class="input" type="search" name="q" value="<%= query.search %>" placeholder="Search a clip, a game, a player…" aria-label="Search">
        </label>
        <div class="select-wrap">
          <select class="select" name="sort" aria-label="Sort">
            <option value="recent"<%= query.sort === 'recent' ? ' selected' : '' %>>Sort: newest</option>
            <option value="old"<%= query.sort === 'old' ? ' selected' : '' %>>Sort: oldest</option>
            <option value="duration"<%= query.sort === 'duration' ? ' selected' : '' %>>Sort: duration</option>
            <option value="size"<%= query.sort === 'size' ? ' selected' : '' %>>Sort: file size</option>
            <option value="alpha"<%= query.sort === 'alpha' ? ' selected' : '' %>>Sort: alphabetical</option>
          </select>
          <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
        </div>
        <button class="btn btn--primary" type="submit">Filter</button>
      </div>
    </header>

    <div class="content">

      <div class="filters">
        <div class="filter">
          <span class="micro">Game</span>
          <div class="select-wrap">
            <select class="select" name="game" aria-label="Game filter">
              <option value="">All games</option>
              <% games.forEach(function (game) { %>
              <option value="<%= game.slug %>"<%= query.game === game.slug ? ' selected' : '' %>><%= game.name %> (<%= game.count %>)</option>
              <% }); %>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Tag</span>
          <div class="select-wrap">
            <select class="select" name="tag" aria-label="Tag filter">
              <option value="">All tags</option>
              <% tags.forEach(function (tag) { %>
              <option value="<%= tag %>"<%= query.tag === tag ? ' selected' : '' %>><%= tag %></option>
              <% }); %>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Date</span>
          <div class="select-wrap">
            <select class="select" name="date" aria-label="Date filter">
              <option value=""<%= !query.date ? ' selected' : '' %>>Any</option>
              <option value="7"<%= query.date === '7' ? ' selected' : '' %>>Last 7 days</option>
              <option value="30"<%= query.date === '30' ? ' selected' : '' %>>Last 30 days</option>
              <option value="365"<%= query.date === '365' ? ' selected' : '' %>>This year</option>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filter">
          <span class="micro">Duration</span>
          <div class="select-wrap">
            <select class="select" name="duration" aria-label="Duration filter">
              <option value=""<%= !query.duration ? ' selected' : '' %>>Any duration</option>
              <option value="short"<%= query.duration === 'short' ? ' selected' : '' %>>&lt; 1 min</option>
              <option value="mid"<%= query.duration === 'mid' ? ' selected' : '' %>>1 – 3 min</option>
              <option value="long"<%= query.duration === 'long' ? ' selected' : '' %>>&gt; 3 min</option>
            </select>
            <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
          </div>
        </div>
        <div class="filters__right">
          <span class="mono"><%= total %> result<%= total > 1 ? 's' : '' %> · <%= perPage %> per page</span>
          <a class="btn btn--ghost btn--sm" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-refresh"></use></svg>Reset</a>
        </div>
      </div>
    </form>

      <% if (!user) { %>
      <div class="session-note mb4">
        <svg aria-hidden="true" focusable="false" class="ic ic--sm faint"><use href="#i-lock"></use></svg>
        <span class="grow">Public view — <%= total %> clip<%= total > 1 ? 's' : '' %> can be watched without an account.
          <% if (counting.clips > total) { %><%= counting.clips - total %> more are reserved for members.<% } %></span>
        <a class="btn btn--sm" href="/login">Sign in</a>
      </div>
      <% } %>

      <% if (clips.length) { %>
      <div class="grid-clips">
        <% clips.forEach(function (clip) { %>
        <%- include('partials/clip-card', { clip: clip }) %>
        <% }); %>
      </div>

      <% if (pages > 1) { %>
      <% function pageUrl(target) {
           const params = new URLSearchParams();
           if (query.search) params.set('q', query.search);
           if (query.game) params.set('game', query.game);
           if (query.tag) params.set('tag', query.tag);
           if (query.date) params.set('date', query.date);
           if (query.duration) params.set('duration', query.duration);
           if (query.sort !== 'recent') params.set('sort', query.sort);
           params.set('page', String(target));
           return '/library?' + params.toString();
         } %>
      <div class="pager">
        <span class="mono"><%= (page - 1) * perPage + 1 %>–<%= Math.min(page * perPage, total) %> of <%= total %></span>
        <div class="pager__pages">
          <% if (page > 1) { %>
          <a href="<%= pageUrl(page - 1) %>" aria-label="Previous page"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-left"></use></svg></a>
          <% } %>
          <% for (let p = Math.max(1, page - 2); p <= Math.min(pages, page + 2); p += 1) { %>
            <% if (p === page) { %>
            <span class="is-current" aria-current="page"><%= p %></span>
            <% } else { %>
            <a href="<%= pageUrl(p) %>"><%= p %></a>
            <% } %>
          <% } %>
          <% if (page < pages) { %>
          <a href="<%= pageUrl(page + 1) %>" aria-label="Next page"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-right"></use></svg></a>
          <% } %>
        </div>
        <span class="mono faint"><%= pages %> pages</span>
      </div>
      <% } %>

      <% } else { %>
      <div class="empty">
        <svg aria-hidden="true" focusable="false" class="ic ic--lg"><use href="#i-search"></use></svg>
        <p class="section-title">No clip matches these filters</p>
        <p class="dim">Search covers titles, games, descriptions and tags.</p>
        <div class="flex">
          <a class="btn btn--primary" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-refresh"></use></svg>Reset all</a>
          <a class="btn btn--ghost" href="/upload"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-upload"></use></svg>Upload a clip</a>
        </div>
      </div>
      <% } %>

    </div>

<%- include('partials/shell-end') %>
