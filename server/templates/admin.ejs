<%- include('partials/shell-start', { title: title, active: 'admin' }) %>

    <header class="topbar">
      <div>
        <p class="micro">Administration</p>
        <h1 class="page-title mt2">Réglages de l'instance</h1>
        <p class="page-sub">vault://<%= instance.toLowerCase().replace(/\s+/g, '-') %> — <%= counting.clips %> clips · <%= counting.members %> membres · <%= fmt.bytes(counting.bytes) %></p>
      </div>
      <div class="topbar__actions">
        <a class="btn" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-film"></use></svg>Bibliothèque</a>
      </div>
    </header>

    <div class="content">

      <% if (flash) { %>
      <div class="alert alert--ok mb4" role="status">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-check"></use></svg>
        <div><p><%= flash %></p></div>
      </div>
      <% } %>
      <% if (error) { %>
      <div class="alert mb4" role="alert">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-alert"></use></svg>
        <div><p><%= error %></p></div>
      </div>
      <% } %>

      <div class="upload-cols">

        <div class="stack">
          <section>
            <div class="rule-label"><span>Instance</span></div>
            <form method="post" action="/admin/settings">
            <div class="panel">
              <div class="field">
                <label for="instance_name">Nom de l'instance</label>
                <input class="input" id="instance_name" name="instance_name" type="text" maxlength="60" value="<%= settings.instance_name %>" placeholder="<%= instance %>">
                <span class="field__hint">laisser vide pour utiliser la valeur de configuration</span>
              </div>

              <div class="field mt4">
                <label for="public_url">URL publique de l'instance</label>
                <input class="input" id="public_url" name="public_url" type="text" value="<%= settings.public_url %>" placeholder="<%= baseUrl %>">
                <span class="field__hint">sert aux liens d'invitation, de partage et au retour d'authentification — laisser vide pour déduire de la requête (<%= baseUrl %>)</span>
              </div>

              <div class="field mt4">
                <label for="default_tags">Tags par défaut</label>
                <input class="input" id="default_tags" name="default_tags" type="text" value="<%= settings.default_tags %>" placeholder="clip, jeuxvideo">
                <span class="field__hint">séparés par des virgules — ajoutés à chaque nouveau dépôt, en plus des tags saisis</span>
              </div>

              <div class="field mt4">
                <span class="micro">Thème de l'instance</span>
                <div class="radio-list">
                  <% themes.forEach(function (item) { %>
                  <label class="radio<%= settings.theme === item.key ? ' is-checked' : '' %>">
                    <input type="radio" name="theme" value="<%= item.key %>"<%= settings.theme === item.key ? ' checked' : '' %>>
                    <span class="swatch" style="--sw: <%= item.accent %>" aria-hidden="true"></span>
                    <span><%= item.label %></span>
                    <span class="num"><%= item.scheme === 'dark' ? 'sombre' : 'clair' %></span>
                  </label>
                  <% }); %>
                </div>
                <span class="field__hint">s'applique à toute l'instance, page de connexion et liens partagés compris</span>
              </div>

              <div class="form-grid mt4">
                <div class="field">
                  <label for="default_visibility">Visibilité par défaut d'un dépôt</label>
                  <div class="select-wrap">
                    <select class="select" id="default_visibility" name="default_visibility">
                      <option value="link"<%= settings.default_visibility === 'link' ? ' selected' : '' %>>Accès par lien</option>
                      <option value="members"<%= settings.default_visibility === 'members' ? ' selected' : '' %>>Membres de l'instance</option>
                      <option value="public"<%= settings.default_visibility === 'public' ? ' selected' : '' %>>Public</option>
                    </select>
                    <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
                  </div>
                </div>
                <div class="field">
                  <label for="link_expiry_days">Expiration des liens publics</label>
                  <input class="input" id="link_expiry_days" name="link_expiry_days" type="number" min="0" max="365" value="<%= settings.link_expiry_days %>">
                  <span class="field__hint">en jours — 0 = jamais</span>
                </div>
                <div class="field">
                  <label for="max_upload_gb">Taille maximale d'un fichier</label>
                  <input class="input" id="max_upload_gb" name="max_upload_gb" type="number" min="1" max="64" value="<%= settings.max_upload_gb %>">
                  <span class="field__hint">en Go</span>
                </div>
                <div class="field">
                  <label for="invite_only">Accès</label>
                  <div class="radio-list">
                    <label class="radio<%= settings.invite_only === 'true' ? ' is-checked' : '' %>">
                      <input type="checkbox" name="invite_only"<%= settings.invite_only === 'true' ? ' checked' : '' %>>
                      <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-lock"></use></svg>
                      <span>Sur invitation uniquement</span>
                    </label>
                  </div>
                  <span class="field__hint">une première connexion SSO exige un jeton valide</span>
                </div>
              </div>

              <div class="row-actions mt5">
                <button class="btn btn--primary" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-check"></use></svg>Enregistrer</button>
              </div>
            </div>
            </form>
          </section>

          <section>
            <div class="rule-label"><span>Membres — <%= members.length %></span></div>
            <div class="panel">
              <% members.forEach(function (member) { %>
              <div class="rowline member-row">
                <svg aria-hidden="true" focusable="false" class="ic ic--sm faint"><use href="#i-user"></use></svg>
                <span class="grow"><strong><%= member.username %></strong><% if (member.display_name && member.display_name !== member.username) { %> — <span class="dim"><%= member.display_name %></span><% } %></span>
                <span class="num"><%= member.clips %> clip<%= member.clips > 1 ? 's' : '' %></span>
                <span class="num faint"><%= member.last_clip ? fmt.relative(member.last_clip) : 'jamais' %></span>
                <form method="post" action="/admin/members/<%= member.id %>/role">
                  <input type="hidden" name="role" value="<%= member.role === 'admin' ? 'member' : 'admin' %>">
                  <button class="btn btn--sm<%= member.role === 'admin' ? ' btn--ghost' : '' %>" type="submit">
                    <%= member.role === 'admin' ? 'Retirer admin' : 'Nommer admin' %>
                  </button>
                </form>
              </div>
              <% }); %>
            </div>
          </section>
        </div>

        <div class="stack">
          <section>
            <div class="rule-label"><span>Invitation</span></div>
            <form method="post" action="/admin/invites">
            <div class="panel">
              <div class="field">
                <label for="note">Note</label>
                <input class="input" id="note" name="note" type="text" maxlength="80" placeholder="pour qui ?">
              </div>
              <div class="field mt4">
                <label for="expires_days">Validité</label>
                <div class="select-wrap">
                  <select class="select" id="expires_days" name="expires_days">
                    <option value="1">1 jour</option>
                    <option value="7" selected>7 jours</option>
                    <option value="30">30 jours</option>
                    <option value="0">sans limite</option>
                  </select>
                  <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
                </div>
              </div>
              <button class="btn btn--primary btn--block mt4" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-plus"></use></svg>Créer un lien d'invitation</button>
            </div>
            </form>
          </section>

          <section>
            <div class="rule-label"><span>Jetons — <%= invites.length %></span></div>
            <div class="panel">
              <% if (!invites.length) { %>
              <p class="dim">Aucune invitation. Les liens créés apparaissent ici, avec leur état.</p>
              <% } %>
              <% invites.forEach(function (invite) { %>
              <div class="qitem">
                <div class="qitem__icon"><svg aria-hidden="true" focusable="false" class="ic"><use href="#i-<%= invite.used_at ? 'check' : 'link' %>"></use></svg></div>
                <div>
                  <div class="flex flex--between">
                    <span class="qitem__name mono"><%= baseUrl %>/join/<%= invite.token %></span>
                    <span class="badge<%= invite.used_at ? ' badge--ok' : '' %>"><%= invite.used_at ? 'Utilisé' : 'Actif' %></span>
                  </div>
                  <div class="qitem__meta">
                    <%= invite.note || 'sans note' %> · créé <%= fmt.relative(invite.created_at) %>
                    <% if (invite.used_at) { %> · par <%= invite.used_by_name %><% } %>
                    <% if (invite.expires_at) { %> · expire le <%= fmt.dateShort(invite.expires_at) %><% } %>
                  </div>
                </div>
                <% if (!invite.used_at) { %>
                <button class="btn btn--icon btn--sm btn--ghost" type="button" data-copy="<%= baseUrl %>/join/<%= invite.token %>" aria-label="Copier le lien d'invitation"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-copy"></use></svg></button>
                <form method="post" action="/admin/invites/<%= invite.id %>/revoke">
                  <button class="btn btn--icon btn--sm btn--ghost" type="submit" aria-label="Révoquer"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-x"></use></svg></button>
                </form>
                <% } %>
              </div>
              <% }); %>
            </div>
            <p class="mono mt3">Un jeton ne sert qu'une fois. Le lien ouvre la connexion Authentik ; le compte est créé au premier login.</p>
          </section>
        </div>

      </div>
    </div>

<script src="/assets/copy.js" defer></script>

<%- include('partials/shell-end') %>
