<%- include('partials/shell-start', { title: title, active: 'admin' }) %>

    <header class="topbar">
      <div>
        <p class="micro">Administration</p>
        <h1 class="page-title mt2">Instance settings</h1>
        <p class="page-sub">vault://<%= instance.toLowerCase().replace(/\s+/g, '-') %> — <%= counting.clips %> clips · <%= counting.members %> members · <%= fmt.bytes(counting.bytes) %></p>
      </div>
      <div class="topbar__actions">
        <a class="btn" href="/library"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-film"></use></svg>Library</a>
      </div>
    </header>

    <div class="content">

      <% if (flash) { %>
      <div class="alert alert--ok mb4" role="status">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-check"></use></svg>
        <div><p><%= flash %></p></div>
      </div>
      <% } %>
      <% if (error) { %>
      <div class="alert mb4" role="alert">
        <svg aria-hidden="true" focusable="false" class="ic"><use href="#i-alert"></use></svg>
        <div><p><%= error %></p></div>
      </div>
      <% } %>

      <div class="upload-cols">

        <div class="stack">
          <section>
            <div class="rule-label"><span>Instance</span></div>
            <form method="post" action="/admin/settings">
            <div class="panel">
              <div class="field">
                <label for="instance_name">Instance name</label>
                <input class="input" id="instance_name" name="instance_name" type="text" maxlength="60" value="<%= settings.instance_name %>" placeholder="<%= instance %>">
                <span class="field__hint">leave empty to use the configuration value</span>
              </div>

              <div class="field mt4">
                <label for="public_url">Instance public URL</label>
                <input class="input" id="public_url" name="public_url" type="text" value="<%= settings.public_url %>" placeholder="<%= baseUrl %>">
                <span class="field__hint">used for invitation links, share links and the authentication callback — leave empty to derive it from the request (<%= baseUrl %>)</span>
              </div>

              <div class="field mt4">
                <label>Video storage</label>
                <div class="storage-line">
                  <span class="storage-line__bar" aria-hidden="true"><span style="width: <%= Math.min(100, storage.percent) %>%"></span></span>
                  <span class="storage-line__text"><%= storage.free %> free of <%= storage.total %> · <%= storage.percent %>% used</span>
                </div>
                <% if (storage.saturated) { %>
                <span class="field__hint field__hint--warn">quota reached: uploads are rejected until space is freed</span>
                <% } else { %>
                <span class="field__hint">reads the filesystem directly — the volume quota is authoritative</span>
                <% } %>
              </div>

              <div class="field mt4">
                <label for="default_tags">Default tags</label>
                <div class="tag-editor" data-tag-editor="default_tags">
                  <% var actifs = settings.default_tags.split(',').map(function (t) { return t.trim().toLowerCase(); }).filter(Boolean); %>
                  <% var proposes = baseTagChoices.concat(actifs.filter(function (t) { return baseTagChoices.indexOf(t) < 0; })); %>
                  <div class="tag-editor__applied" data-applied>
                    <% actifs.forEach(function (tag) { %>
                    <button class="tag tag--chip is-active" type="button" data-remove-tag="<%= tag %>">
                      <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-x"></use></svg><%= tag %>
                    </button>
                    <% }); %>
                  </div>
                  <p class="tag-editor__empty" data-empty>No default tags — click a suggestion below.</p>
                  <div class="tag-editor__pool" data-pool>
                    <% proposes.filter(function (t) { return actifs.indexOf(t) < 0; }).forEach(function (tag) { %>
                    <button class="tag tag--chip" type="button" data-add-tag="<%= tag %>"><%= tag %></button>
                    <% }); %>
                  </div>
                  <input class="input tag-editor__input" type="text" id="tag-ajout" placeholder="another tag…" aria-label="Add a default tag">
                </div>
                <input type="hidden" id="default_tags" name="default_tags" value="<%= settings.default_tags %>">
                <span class="field__hint">filled chips are applied by default — click one to remove it, a grey chip to add it</span>
              </div>

              <div class="field mt4">
                <span class="micro">Instance theme</span>
                <div class="radio-list">
                  <% themes.forEach(function (item) { %>
                  <label class="radio<%= settings.theme === item.key ? ' is-checked' : '' %>">
                    <input type="radio" name="theme" value="<%= item.key %>"<%= settings.theme === item.key ? ' checked' : '' %>>
                    <span class="swatch" style="--sw: <%= item.accent %>" aria-hidden="true"></span>
                    <span><%= item.label %></span>
                    <span class="num"><%= item.scheme === 'dark' ? 'dark' : 'light' %></span>
                  </label>
                  <% }); %>
                </div>
                <span class="field__hint">applies to the whole instance, sign-in page and shared links included</span>
              </div>

              <div class="form-grid mt4">
                <div class="field">
                  <label for="default_visibility">Default visibility for an upload</label>
                  <div class="select-wrap">
                    <select class="select" id="default_visibility" name="default_visibility">
                      <option value="link"<%= settings.default_visibility === 'link' ? ' selected' : '' %>>Link access</option>
                      <option value="members"<%= settings.default_visibility === 'members' ? ' selected' : '' %>>Instance members</option>
                      <option value="public"<%= settings.default_visibility === 'public' ? ' selected' : '' %>>Public</option>
                    </select>
                    <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
                  </div>
                </div>
                <div class="field">
                  <label for="link_expiry_days">Public link expiry</label>
                  <input class="input" id="link_expiry_days" name="link_expiry_days" type="number" min="0" max="365" value="<%= settings.link_expiry_days %>">
                  <span class="field__hint">in days — 0 = never</span>
                </div>
                <div class="field">
                  <label for="max_upload_gb">Maximum file size</label>
                  <input class="input" id="max_upload_gb" name="max_upload_gb" type="number" min="1" max="64" value="<%= settings.max_upload_gb %>">
                  <span class="field__hint">in GB</span>
                </div>
                <div class="field">
                  <label for="invite_only">Access</label>
                  <div class="radio-list">
                    <label class="radio<%= settings.invite_only === 'true' ? ' is-checked' : '' %>">
                      <input type="checkbox" name="invite_only"<%= settings.invite_only === 'true' ? ' checked' : '' %>>
                      <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-lock"></use></svg>
                      <span>Invite only</span>
                    </label>
                  </div>
                  <span class="field__hint">a first SSO sign-in requires a valid token</span>
                </div>
              </div>

              <div class="row-actions mt5">
                <button class="btn btn--primary" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-check"></use></svg>Save</button>
              </div>
            </div>
            </form>
          </section>

          <section>
            <div class="rule-label"><span>Members — <%= members.length %></span></div>
            <div class="panel">
              <% members.forEach(function (member) { %>
              <div class="rowline member-row">
                <svg aria-hidden="true" focusable="false" class="ic ic--sm faint"><use href="#i-user"></use></svg>
                <span class="grow"><strong><%= member.username %></strong><% if (member.display_name && member.display_name !== member.username) { %> — <span class="dim"><%= member.display_name %></span><% } %></span>
                <span class="num"><%= member.clips %> clip<%= member.clips > 1 ? 's' : '' %></span>
                <span class="num faint"><%= member.last_clip ? fmt.relative(member.last_clip) : 'never' %></span>
                <form method="post" action="/admin/members/<%= member.id %>/role">
                  <input type="hidden" name="role" value="<%= member.role === 'admin' ? 'member' : 'admin' %>">
                  <button class="btn btn--sm<%= member.role === 'admin' ? ' btn--ghost' : '' %>" type="submit">
                    <%= member.role === 'admin' ? 'Remove admin' : 'Make admin' %>
                  </button>
                </form>
              </div>
              <% }); %>
            </div>
          </section>
        </div>

        <div class="stack">
          <section>
            <div class="rule-label"><span>Invitation</span></div>
            <form method="post" action="/admin/invites">
            <div class="panel">
              <div class="field">
                <label for="note">Note</label>
                <input class="input" id="note" name="note" type="text" maxlength="80" placeholder="for whom?">
              </div>
              <div class="field mt4">
                <label for="expires_days">Validity</label>
                <div class="select-wrap">
                  <select class="select" id="expires_days" name="expires_days">
                    <option value="1">1 day</option>
                    <option value="7" selected>7 days</option>
                    <option value="30">30 days</option>
                    <option value="0">no limit</option>
                  </select>
                  <svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-chev-down"></use></svg>
                </div>
              </div>
              <button class="btn btn--primary btn--block mt4" type="submit"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-plus"></use></svg>Create invite link</button>
            </div>
            </form>
          </section>

          <section>
            <div class="rule-label"><span>Tokens — <%= invites.length %></span></div>
            <div class="panel">
              <% if (!invites.length) { %>
              <p class="dim">No invitations. Created links appear here with their status.</p>
              <% } %>
              <% invites.forEach(function (invite) { %>
              <div class="qitem">
                <div class="qitem__icon"><svg aria-hidden="true" focusable="false" class="ic"><use href="#i-<%= invite.used_at ? 'check' : 'link' %>"></use></svg></div>
                <div>
                  <div class="flex flex--between">
                    <span class="qitem__name mono"><%= baseUrl %>/join/<%= invite.token %></span>
                    <span class="badge<%= invite.used_at ? ' badge--ok' : '' %>"><%= invite.used_at ? 'Used' : 'Active' %></span>
                  </div>
                  <div class="qitem__meta">
                    <%= invite.note || 'no note' %> · created <%= fmt.relative(invite.created_at) %>
                    <% if (invite.used_at) { %> · by <%= invite.used_by_name %><% } %>
                    <% if (invite.expires_at) { %> · expires <%= fmt.dateShort(invite.expires_at) %><% } %>
                  </div>
                </div>
                <% if (!invite.used_at) { %>
                <button class="btn btn--icon btn--sm btn--ghost" type="button" data-copy="<%= baseUrl %>/join/<%= invite.token %>" aria-label="Copy invite link"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-copy"></use></svg></button>
                <form method="post" action="/admin/invites/<%= invite.id %>/revoke">
                  <button class="btn btn--icon btn--sm btn--ghost" type="submit" aria-label="Revoke"><svg aria-hidden="true" focusable="false" class="ic ic--sm"><use href="#i-x"></use></svg></button>
                </form>
                <% } %>
              </div>
              <% }); %>
            </div>
            <p class="mono mt3">A token works only once. The link opens Authentik sign-in; the account is created on first login.</p>
          </section>
        </div>

      </div>
    </div>

<script src="/assets/copy.js" defer></script>

<script src="/assets/tags.js" defer></script>

<%- include('partials/shell-end') %>
