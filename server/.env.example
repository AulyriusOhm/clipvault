# Instance
HOST=0.0.0.0
PORT=8099
INSTANCE_NAME=La Tanière
BASE_URL=http://localhost:8099
LOG_LEVEL=info

# Sessions (32 caractères minimum). Absent = secret généré dans data/.session-secret
# SESSION_SECRET=

# Dépôt
MAX_UPLOAD_GB=4

# Authentification : dev (bouton de connexion local) ou oidc (Authentik)
AUTH_MODE=dev

# Renseigné uniquement si AUTH_MODE=oidc
# OIDC_ISSUER=https://auth.lanro.eu/application/o/clipvault/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=   # facultatif : déduit de l'en-tête Host si absent
# OIDC_SCOPES=openid profile email
# OIDC_AUTO_CREATE=true
# OIDC_ADMIN_GROUP=clipvault-admins
