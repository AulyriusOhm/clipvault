# Instance
HOST=0.0.0.0
PORT=8099
INSTANCE_NAME=La Tanière
BASE_URL=http://localhost:8099
LOG_LEVEL=info

# Sessions (32 characters minimum). Absent = secret generated in data/.session-secret
# SESSION_SECRET=

# Upload
MAX_UPLOAD_GB=4

# Video storage (default: data/media). In a container: /media if the volume is mounted there
# MEDIA_DIR=/media

# Behind a proxy that terminates TLS (WAF, Caddy, Traefik)
# TRUST_PROXY=1      # number of trusted proxies; 'true' trusts the whole XFF chain (spoofable)
# COOKIE_SECURE=true

# Authentication: dev (local sign-in button) or oidc (Authentik)
AUTH_MODE=dev

# Fill in only if AUTH_MODE=oidc
# OIDC_ISSUER=https://auth.lanro.eu/application/o/clipvault/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=   # optional: derived from the Host header if absent
# OIDC_SCOPES=openid profile email
# OIDC_AUTO_CREATE=true
# OIDC_ADMIN_GROUP=clipvault-admins
